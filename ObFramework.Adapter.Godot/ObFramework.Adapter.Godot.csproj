<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Retargeted from netstandard2.1: the installed GodotSharp 4.7.2 targets net8, so a
             netstandard2.1 project fails with CS1705 on this machine. File layout unchanged. -->
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>9</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <Reference Include="GodotSharp">
        <HintPath>..\..\..\Program Files\Godot\GodotSharp\Api\Release\GodotSharp.dll</HintPath>
      </Reference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Framework\ObFramework.csproj" />
      <ProjectReference Include="..\ObFramework.Generator\ObFramework.Generator.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Asset\UIRoot.tscn" />
    </ItemGroup>

</Project>
