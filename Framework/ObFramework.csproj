<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <UserSecretsId>99e0760f-80a2-4396-b6c4-c58f67b39c5d</UserSecretsId>
    <GenerateDocumentationFile>False</GenerateDocumentationFile>
    <EnableNETAnalyzers>False</EnableNETAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <!-- The engine binding layers bootstrap lifecycle for views they construct directly (child
         components bound on a prefab hierarchy have no UIManager entry, so their OnInit must run
         when the binding creates them). Keep this seam internal to the framework + adapters. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ObFramework.Adapter.Unity</_Parameter1>
    </AssemblyAttribute>
    <!-- Editor-tools compile-validation build mode of the same adapter project. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ObFramework.Adapter.Unity.EditorTools</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ObFramework.Adapter.Godot</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ObFramework.Adapter.UnrealSharp</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ObFramework.Test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" Version="3.1.12" />
    <PackageReference Include="MessagePack.Annotations" Version="3.1.12" />
    <PackageReference Include="MessagePackAnalyzer" Version="3.1.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MessagePipe" Version="1.8.2" />
    <PackageReference Include="MessagePipe.Analyzer" Version="1.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="ZLinq" Version="1.6.1" />
    <PackageReference Include="ZString" Version="2.6.0" />
  </ItemGroup>

</Project>
