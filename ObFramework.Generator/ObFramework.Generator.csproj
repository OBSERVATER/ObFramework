<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<LangVersion>9.0</LangVersion>
		<Nullable>enable</Nullable>
		<IsRoslynComponent>true</IsRoslynComponent>
	</PropertyGroup>
	<ItemGroup>
		<!-- Unity 2022.3 ships Roslyn 4.3.1. Both the Save generator and the CDE generator are
		     compiled against that baseline so the same assemblies load inside the Unity Editor
		     (IIncrementalGenerator / ForAttributeWithMetadataName are available from 4.3). -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.1" PrivateAssets="all" />
	</ItemGroup>

</Project>
