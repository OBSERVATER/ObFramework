<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Static compile validation for the deployable Unity Editor sources:
      ObFramework.Adapter.Unity/EditorDeploy/*.cs (thin UnityEditor glue) plus the referenced pure
      ObFramework.Editor.Core project (whose sources live in EditorDeploy/Core/**).

      This project is a build-only guard: it never ships. The same glue sources are deployed into a
      Unity project by `ob unity deploy` and imported by the Unity Editor asmdef
      (EditorDeploy/ObFramework.Adapter.Unity.Editor.asmdef). Real Unity Prefab serialization,
      Editor menu discovery and asset import cannot be verified here (no Unity Editor process).
    -->
    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <LangVersion>9</LangVersion>
        <Nullable>enable</Nullable>
        <AssemblyName>ObFramework.Adapter.Unity.Editor</AssemblyName>
        <RootNamespace>ObFramework.Adapter.Unity.EditorTools</RootNamespace>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <!-- Unity assemblies are .NET Framework/editor assemblies; keep their resolution warnings quiet. -->
        <NoWarn>$(NoWarn);MSB3277;MSB3270;CS1701;CS1702</NoWarn>
        <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    </PropertyGroup>

    <ItemGroup>
        <!-- Deployable UnityEditor glue sources at the EditorDeploy root. Core/** belongs to ObFramework.Editor.Core. -->
        <Compile Include="..\ObFramework.Adapter.Unity\EditorDeploy\*.cs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ObFramework.Editor.Core\ObFramework.Editor.Core.csproj" />
        <ProjectReference Include="..\Framework\ObFramework.csproj" />
        <ProjectReference Include="..\ObFramework.Adapter.Unity\ObFramework.Adapter.Unity.csproj" />
    </ItemGroup>

    <PropertyGroup>
        <UnityEditorDataRoot>..\..\..\Program Files\Unity Editor\2022.3.58.f1\Editor\Data\Managed</UnityEditorDataRoot>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="UnityEngine">
            <HintPath>$(UnityEditorDataRoot)\UnityEngine\UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(UnityEditorDataRoot)\UnityEngine\UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(UnityEditorDataRoot)\UnityEngine\UnityEngine.IMGUIModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.JSONSerializeModule">
            <HintPath>$(UnityEditorDataRoot)\UnityEngine\UnityEngine.JSONSerializeModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEditor">
            <HintPath>$(UnityEditorDataRoot)\UnityEditor.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

</Project>
